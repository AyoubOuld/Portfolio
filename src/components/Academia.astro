---
import SectionHeading from "./SectionHeading.astro";
import { masters, bachelors } from "../data/academia.js";
import { asset } from "../lib/asset.js";

const { thesis } = masters;
---

<section id="academia" class="section">
  <div class="wrap">
    <SectionHeading
      number="02"
      title="Academia"
      intro="Two degrees, two top-of-class finishes, and a thesis on reading the market through social media."
    />

    <div class="grid">
      <article class="degree main">
        <img class="logo" src={asset(masters.logo.src)} alt={masters.logo.alt} width={masters.logo.width} height={masters.logo.height} loading="lazy" />
        <span class="dates">{masters.dates}</span>
        <h3>{masters.degree}</h3>
        <p class="school">{masters.school}</p>
        <div class="chips">
          {masters.honours.map((item) => <span class="chip">{item}</span>)}
        </div>

        <div class="thesis">
          <p class="label">Master's thesis</p>
          <h4>{thesis.title}</h4>
          <p>{thesis.summary}</p>
          <p class="supervisor">Supervised by {thesis.supervisor}</p>
          <div class="chips">
            {thesis.topics.map((topic) => <span class="chip">{topic}</span>)}
          </div>
          <a class="repo" href={thesis.repo.href} target="_blank" rel="noopener">
            <svg viewBox="0 0 16 16" aria-hidden="true">
              <path
                fill="currentColor"
                d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"
              ></path>
            </svg>
            <span>See the code on GitHub</span>
            <small>{thesis.repo.label}</small>
          </a>
        </div>
      </article>

      <article class="degree">
        <img class="logo small" src={asset(bachelors.logo.src)} alt={bachelors.logo.alt} width={bachelors.logo.width} height={bachelors.logo.height} loading="lazy" />
        <span class="dates">{bachelors.dates}</span>
        <h3>{bachelors.degree}</h3>
        <p class="school">{bachelors.school}</p>
        <div class="chips">
          {bachelors.honours.map((item) => <span class="chip">{item}</span>)}
        </div>
        <p>{bachelors.summary}</p>
      </article>
    </div>
  </div>
</section>

<style>
  .grid {
    display: grid;
    grid-template-columns: 1.6fr 1fr;
    gap: 22px;
    align-items: start;
  }

  .degree {
    display: grid;
    gap: 12px;
    padding: 30px;
    border: 1px solid var(--line);
    border-radius: 22px;
    background: var(--paper);
  }

  .main {
    border-color: var(--pill-green);
    background: var(--pill-green);
    color: var(--cream);
  }

  .logo {
    display: block;
    width: 170px;
    height: auto;
    margin-bottom: 4px;
  }

  .logo.small {
    width: 100px;
  }

  .dates {
    font-family: var(--plain);
    font-weight: 600;
    font-size: 14px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    opacity: 0.75;
  }

  h3 {
    font-family: var(--pearl);
    font-weight: 400;
    font-size: clamp(24px, 2vw, 28px);
    line-height: 1.22;
  }

  .main h3 {
    font-size: clamp(26px, 2.6vw, 36px);
  }

  .degree p {
    margin: 0;
    font-family: var(--plain);
    font-size: 17px;
    line-height: 1.55;
  }

  .degree .school {
    font-size: 16px;
    opacity: 0.75;
  }

  .main .chip {
    border-color: rgba(245, 239, 227, 0.5);
  }

  .thesis {
    display: grid;
    gap: 12px;
    margin-top: 14px;
    padding-top: 20px;
    border-top: 1px solid rgba(245, 239, 227, 0.25);
  }

  .thesis .label {
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    opacity: 0.7;
  }

  h4 {
    font-family: var(--elegant);
    font-weight: 400;
    font-size: clamp(22px, 2.2vw, 30px);
    line-height: 1.2;
  }

  .thesis .supervisor {
    font-style: italic;
    opacity: 0.8;
  }

  .repo {
    display: inline-grid;
    grid-template-columns: auto 1fr;
    align-items: center;
    column-gap: 12px;
    justify-self: start;
    margin-top: 6px;
    padding: 12px 20px 12px 14px;
    border-radius: 16px;
    background: var(--cream);
    color: var(--pill-green);
    font-family: var(--plain);
    text-decoration: none;
  }

  .repo svg {
    grid-row: span 2;
    width: 28px;
    height: 28px;
  }

  .repo span {
    font-size: 16px;
    font-weight: 600;
  }

  .repo small {
    font-size: 13px;
    opacity: 0.65;
  }

  .repo:hover span {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  @media (max-width: 860px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
