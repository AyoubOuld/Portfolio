---
import SectionHeading from "./SectionHeading.astro";
import CaseCard from "./CaseCard.astro";
import { work } from "../data/profile.js";
---

<section id="work" class="section">
  <div class="wrap">
    <SectionHeading
      number="05"
      title="Selected work"
      intro="A few projects from my roles that show how I approach a problem."
    />

    <div class="grid">
      {work.map((item) => <CaseCard {...item} />)}
    </div>
  </div>
</section>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 22px;
  }

  @media (max-width: 860px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
