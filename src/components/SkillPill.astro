---
import Star from "./Star.astro";

interface Props {
  name: string;
  detail: string;
  copy?: boolean;
}

const { name, detail, copy = false } = Astro.props;
---

<button
  type="button"
  class="pill"
  data-detail={detail}
  tabindex={copy ? -1 : undefined}
  aria-hidden={copy ? "true" : undefined}
>
  <span class="icon"><Star /></span>
  {name}
</button>

<style>
  .pill {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    padding: 4px 18px 4px 4px;
    border: 0;
    border-radius: 999px;
    background: var(--pill-bg);
    color: var(--pill-fg);
    font-family: var(--plain);
    font-weight: 500;
    font-size: clamp(13px, 1.1vw, 17px);
    letter-spacing: 0.01em;
    line-height: 1;
    white-space: nowrap;
    cursor: help;
    transition: transform 0.2s, box-shadow 0.2s;
  }

  .pill:hover,
  .pill:focus-visible,
  .pill.active {
    transform: translateY(-2px);
    box-shadow: 0 8px 18px -8px rgba(0, 0, 0, 0.5);
  }

  .pill:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 3px;
  }

  .icon {
    flex: none;
    display: grid;
    place-items: center;
    width: clamp(22px, 2vw, 30px);
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--pill-fg);
    color: var(--pill-bg);
  }

  .icon :global(svg) {
    width: 58%;
    height: 58%;
  }
</style>
